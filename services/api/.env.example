NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/renthub
AUTH_MODE=hybrid
LOCAL_JWT_SECRET=replace-with-at-least-32-random-characters
LOCAL_ACCESS_TOKEN_MINUTES=15
LOCAL_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:8080,http://localhost:3001
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com/
AUTH0_AUDIENCE=https://api.renthub.local
AUTH0_WINDOWS_CLIENT_ID=replace-with-native-application-client-id
AUTH0_WEB_CLIENT_ID=replace-with-spa-application-client-id
AUTH0_WINDOWS_CALLBACK_URL=http://127.0.0.1:53124/callback
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication
AUTH0_ROLES_CLAIM=https://renthub/roles
AUTH0_EMAIL_CLAIM=https://renthub/email
AUTH0_NAME_CLAIM=https://renthub/name
EMAIL_MODE=disabled
EMAIL_FROM=RentHub <your.personal@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your.personal@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
RESEND_API_KEY=replace-with-resend-api-key
PASSWORD_RESET_SECRET=replace-with-at-least-32-random-characters
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
STORAGE_MODE=local
UPLOAD_DIRECTORY=.data/uploads
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret-key
SUPABASE_STORAGE_BUCKET=renthub-files
FCM_MODE=disabled
FIREBASE_PROJECT_ID=your-project-id
WEB_APP_URL=http://localhost:8080
MAX_UPLOAD_BYTES=10485760
MAPS_MODE=openstreetmap
OPENSTREETMAP_NOMINATIM_URL=https://nominatim.openstreetmap.org
OPENSTREETMAP_USER_AGENT=RentHub/1.0 (contact: your-email@example.com)
OPENSTREETMAP_MIN_INTERVAL_MS=1000
CATALOG_MODE=domain
CATALOG_PROVIDER_URL=https://www.wikidata.org/w/api.php
CATALOG_WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
CATALOG_VEHICLE_PROVIDER_URL=https://vpic.nhtsa.dot.gov
CATALOG_BOOK_PROVIDER_URL=https://openlibrary.org
CATALOG_CACHE_TTL_HOURS=168
CATALOG_TIMEOUT_MS=4000
CATALOG_MIN_INTERVAL_MS=250
CATALOG_MAX_RESULTS=12
PRICING_INCLUDE_DEMO_SEED=false
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_MS=5000
AI_ENFORCEMENT_MODE=advisory
BLOCKCHAIN_MODE=disabled
GANACHE_RPC_URL=http://localhost:8545
RENTAL_CONTRACT_ARTIFACT=../../blockchain/artifacts/contracts/RentalAgreement.sol/RentalAgreement.json
LIFECYCLE_JOBS_ENABLED=true
LIFECYCLE_JOB_INTERVAL_MS=900000
PENDING_BOOKING_EXPIRY_MINUTES=60
LIFECYCLE_REMINDER_HOURS=24
OVERDUE_GRACE_HOURS=0

