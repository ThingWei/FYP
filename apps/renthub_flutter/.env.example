API_BASE_URL=http://localhost:3000/api/v1
SOCKET_URL=http://localhost:3000
USE_MOCKS=true
AUTH0_DOMAIN=YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=
FIREBASE_ENABLED=false
# Mobile Firebase configuration is loaded from google-services.json or
# GoogleService-Info.plist after running `flutterfire configure`.
# The following values are needed only for a Firebase Web build.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_VAPID_KEY=

